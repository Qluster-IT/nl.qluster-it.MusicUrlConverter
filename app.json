{
  "id": "nl.qluster-it.MusicUrlConverter",
  "version": "1.0.3",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "brandColor": "#4000C1",
  "name": {
    "en": "Music Url Converter",
    "nl": "Muziek Url Omzetter"
  },
  "description": {
    "en": "Play Music URL's on Homey bigger then 900 KB",
    "nl": "Speel muziek URL's op Homey 900 KB"
  },
  "category": [
    "music"
  ],
  "permissions": [],
  "images": {
    "large": "/assets/images/large.png",
    "small": "/assets/images/small.png"
  },
  "source": "https://bitbucket.org/QlusterIT/nl.qluster-it.MusicUrlConverter/",
  "bugs": {
    "url": "https://bitbucket.org/QlusterIT/nl.qluster-it.MusicUrlConverter/issues"
  },
  "homeyCommunityTopicId": 43546,
  "author": {
    "name": "Arie J. Godschalk",
    "email": "arie@qluster-it.nl"
  },
  "flow": {
    "actions": [
      {
        "id": "play_url",
        "title": {
          "en": "Play URL",
          "nl": "Speel URL"
        },
        "titleFormatted": {
          "en": "Play [[url]] on Homey",
          "nl": "Speel [[url]] op Homey"
        },
        "hint": "URL",
        "args": [
          {
            "name": "url",
            "type": "text",
            "placeholder": "Url"
          }
        ]
      }
    ]
  }
}