{
  "id": "nl.qluster-it.MusicUrlConverter",
  "version": "1.2.2",
  "compatibility": ">=5.0.0",
  "platforms":["local"],
  "platformLocalRequiredFeatures": [ "speaker" ],
  "sdk": 3,
  "brandColor": "#4000C1",
  "name": {
    "en": "Music Url Converter",
    "nl": "Muziek Url Omzetter"
  },
  "description": {
    "en": "Play Music URLs on Homey larger then 900 KB",
    "nl": "Speel muziek URL's op Homey groter dan 900 KB"
  },
  "tags": {
    "en": ["homey", "music", "mp3", "wav"],
    "nl": ["homey", "muziek", "mp3", "wav"]
  },
  "category": [
    "music"
  ],
  "permissions": [],
  "images": {
    "large": "/assets/images/large.png",
    "small": "/assets/images/small.png"
  },
	"contributing": {
		"donate": {
			"paypal": {
				"username": "QlusterIT"
			},
      "patreon": {
				"username": "QlusterIT"
			},
      "githubSponsors": {
        "username": "XeroxQ"
      }
		}
	},
  "source": "https://github.com/Qluster-IT/nl.qluster-it.MusicUrlConverter/",
  "bugs": {
    "url": "https://github.com/Qluster-IT/nl.qluster-it.MusicUrlConverter/issues"
  },
  "homeyCommunityTopicId": 43546,
  "author": {
    "name": "Arie J. Godschalk",
    "email": "arie@qluster-it.nl"
  },
  "flow": {
    "actions": [
      {
        "id": "play_url",
        "title": {
          "en": "Play URL",
          "nl": "Speel URL"
        },
        "titleFormatted": {
          "en": "Play [[url]] on Homey",
          "nl": "Speel [[url]] op Homey"
        },
        "hint": "URL",
        "args": [
          {
            "name": "url",
            "type": "text",
            "placeholder": "Url"
          }
        ]
      }
    ]
  }
}